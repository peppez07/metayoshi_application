{
  "name": "metayoshi-wallet",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "validate:env": "tsx scripts/validate-wallet-env.ts",
    "build:validated": "npm run validate:env && npm run build",
    "smoke:evm-token-send-prep": "tsx scripts/prepare-evm-token-sends.ts",
    "verify:stellar-bridge": "tsx scripts/verify-stellar-bridge-client.ts",
    "verify:rtm-multisig": "node --import tsx --test scripts/verify-rtm-multisig.test.ts",
    "verify:server-balances": "tsx scripts/verify-wallet-server-balances.ts",
    "package:releases": "node scripts/repack-releases.mjs",
    "release": "npm run build && npm run package:releases",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-browser": "^15.0.3",
    "@mysten/sui": "^2.6.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "1.3.2",
    "@noble/secp256k1": "^3.0.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^2.0.1",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^14.5.0",
    "@walletconnect/ethereum-provider": "^2.23.7",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "events": "^3.3.0",
    "framer-motion": "^12.34.3",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.1",
    "ripple-binary-codec": "^2.7.0",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.5.0",
    "tronweb": "^6.2.1",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.1.37",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
