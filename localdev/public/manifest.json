{
  "manifest_version": 3,
  "name": "MetaYoshi",
  "version": "0.2.1",
  "version_name": "metayoshi-0.2.1",
  "action": {
    "default_icon": {
      "16": "assets/metayoshi-16.png",
      "32": "assets/metayoshi-32.png",
      "48": "assets/metayoshi-48.png",
      "64": "assets/metayoshi-64.png",
      "128": "assets/metayoshi-128.png"
    }
  },
  "side_panel": {
    "default_path": "app/src/ui/index.html"
  },
  "sidebar_action": {
    "default_title": "MetaYoshi",
    "default_panel": "app/src/ui/index.html"
  },
  "icons": {
    "16": "assets/metayoshi-16.png",
    "32": "assets/metayoshi-32.png",
    "48": "assets/metayoshi-48.png",
    "64": "assets/metayoshi-64.png",
    "128": "assets/metayoshi-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@metayoshi.app"
    }
  },
  "commands": {
    "open-wallet": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open MetaYoshi wallet"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/inpage.js"],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
