# Minimal public baseline.
VITE_API_BASE_URL=https://api.metayoshi.app
VITE_AUTH_API_BASE_URL=https://api.metayoshi.app
VITE_BALANCE_API_BASE_URL=https://api.metayoshi.app
VITE_SEND_API_BASE_URL=https://api.metayoshi.app
VITE_SWAP_API_BASE_URL=https://api.metayoshi.app
VITE_SECURE_BRIDGE_API_BASE_URL=https://api.metayoshi.app
VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=false
VITE_BRIDGE_AUTOCONFIG_INCLUDE_SECRETS=false
VITE_ENABLE_LOCAL_BACKEND_HELP=false
VITE_DEFAULT_NETWORK=eth
VITE_SWAP_API_VERSION=v1

# The wallet expects one canonical backend origin.
# Legacy auth/balance/send/swap subdomains are normalized back to api.*,
# so keeping every service base on the same API origin avoids silent drift.

# Optional service overrides for a self-hosted gateway.
# VITE_AUTH_API_BASE_URL=https://api.yourdomain.com
# VITE_BALANCE_API_BASE_URL=https://api.yourdomain.com
# VITE_SEND_API_BASE_URL=https://api.yourdomain.com
# VITE_SWAP_API_BASE_URL=https://api.yourdomain.com
# VITE_SECURE_BRIDGE_API_BASE_URL=https://api.yourdomain.com
# Solana and TRON wallet transport should use MetaYoshi bridge/server routes only.
# VITE_COSMOS_RPC=https://your-cosmos-rest-or-rpc-endpoint

# Current local C gateway example for this workspace.
# Use this when developing against:
#   C:\Users\Administrator.WIN-ENHC66U4LMF\server_website_metayoshi
# and the gateway is running on NEWSERVER_PORT=18080.
# VITE_ENABLE_LOCAL_BACKEND_HELP=true
# VITE_API_BASE_URL=http://127.0.0.1:18080
# VITE_AUTH_API_BASE_URL=http://127.0.0.1:18080
# VITE_BALANCE_API_BASE_URL=http://127.0.0.1:18080
# VITE_SEND_API_BASE_URL=http://127.0.0.1:18080
# VITE_SWAP_API_BASE_URL=http://127.0.0.1:18080
# VITE_SECURE_BRIDGE_API_BASE_URL=http://127.0.0.1:18080
#
# To auto-import from the sibling server checkout instead of hardcoding URLs:
# VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=true
# VITE_BRIDGE_AUTOCONFIG_INCLUDE_SECRETS=true
#
# When secrets are not auto-imported, token/NFT reads that still rely on
# bridge-token endpoints may require explicit values:
# VITE_BRIDGE_USER=change_me
# VITE_BRIDGE_PASSWORD=change_me
# VITE_BRIDGE_TX_AUTH_KEY=change_me
# VITE_APP_API_KEY=change_me

# Simple test config: set only these two when you want Basic auth against the bridge.
# VITE_BRIDGE_USER=test_user
# VITE_BRIDGE_PASSWORD=test_password


# If you want the wallet to auto-import settings from a sibling server checkout,
# enable `VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=true` and point it at the
# current `server_website_metayoshi/backend_gateway/config/env/...` overlay.
# Local loopback values still require `VITE_ENABLE_LOCAL_BACKEND_HELP=true`.

# Canonical full local example for this workspace:
#   localdev/.env.wallet.local.example

# Optional server-backed features.
# Swap and some secure submit flows need an API key from your own backend.
# VITE_APP_API_KEY=change_me

# Optional secure bridge tx auth.
# VITE_BRIDGE_TX_AUTH_KEY=change_me
# VITE_BRIDGE_TX_AUTH_ROTATE_BY_DATE=true
# VITE_BRIDGE_TX_AUTH_ACCEPT_SKEW_DAYS=1
# VITE_BRIDGE_SECURE_WRITES_ENABLED=true

# Optional swap behavior flags.
# VITE_SWAP_API_VERSION=legacy
# VITE_SWAP_ENABLE_SOLANA_V1=false

# Optional build-time network filtering.
# Hide specific networks from the built wallet:
# VITE_DISABLED_COINS=sol,sui,doge
#
# Or keep only a specific set:
# VITE_ENABLED_COINS=eth,base,arb,polygon
#
# For richer build-time control, create localdev/metayoshi.build.json
# based on localdev/metayoshi.build.example.json
