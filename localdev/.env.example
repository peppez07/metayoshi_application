VITE_API_BASE_URL=https://api.metayoshi.app
VITE_AUTH_API_BASE_URL=https://api.metayoshi.app
VITE_BALANCE_API_BASE_URL=https://api.metayoshi.app
VITE_SEND_API_BASE_URL=https://api.metayoshi.app
VITE_SWAP_API_BASE_URL=https://api.metayoshi.app
VITE_SECURE_BRIDGE_API_BASE_URL=https://api.metayoshi.app
VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=true
VITE_BRIDGE_AUTOCONFIG_INCLUDE_SECRETS=true
VITE_UNISWAP_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
# Must match server APP_API_KEY
VITE_APP_API_KEY=
# Map from server BRIDGE_BASIC_USER
VITE_BRIDGE_USER=
# Map from server BRIDGE_BASIC_PASSWORD
VITE_BRIDGE_PASSWORD=
VITE_SWAP_API_VERSION=legacy
VITE_SWAP_ENABLE_SOLANA_V1=false
# Optional; map from server BRIDGE_TX_AUTH_KEY when tx-key protection is enabled
VITE_BRIDGE_TX_AUTH_KEY=
VITE_BRIDGE_TX_AUTH_ROTATE_BY_DATE=true
VITE_BRIDGE_TX_AUTH_ACCEPT_SKEW_DAYS=1
VITE_BRIDGE_SECURE_WRITES_ENABLED=true
VITE_ENABLED_COINS=all
VITE_DEFAULT_NETWORK=eth
