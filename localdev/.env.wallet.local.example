VITE_ENABLE_LOCAL_BACKEND_HELP=true
VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=false
VITE_BRIDGE_AUTOCONFIG_INCLUDE_SECRETS=false

VITE_API_BASE_URL=http://127.0.0.1:18080
VITE_AUTH_API_BASE_URL=http://127.0.0.1:18080
VITE_BALANCE_API_BASE_URL=http://127.0.0.1:18080
VITE_SEND_API_BASE_URL=http://127.0.0.1:18080
VITE_SWAP_API_BASE_URL=http://127.0.0.1:18080
VITE_SECURE_BRIDGE_API_BASE_URL=http://127.0.0.1:18080

VITE_DEFAULT_NETWORK=eth
VITE_SWAP_API_VERSION=v1
VITE_BRIDGE_SECURE_WRITES_ENABLED=true

# Set these only when your server deployment still requires them for legacy fallback.
VITE_BRIDGE_USER=change_me
VITE_BRIDGE_PASSWORD=change_me
VITE_BRIDGE_TX_AUTH_KEY=change_me
VITE_APP_API_KEY=change_me

# Keep the temporarily disabled families hidden in local builds too.
VITE_DISABLED_COINS=ada,xmr,xrp
