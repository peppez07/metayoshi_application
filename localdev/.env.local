VITE_API_BASE_URL=https://api.metayoshi.app
VITE_AUTH_API_BASE_URL=https://api.metayoshi.app
VITE_BALANCE_API_BASE_URL=https://api.metayoshi.app
VITE_SEND_API_BASE_URL=https://api.metayoshi.app
VITE_SWAP_API_BASE_URL=https://api.metayoshi.app
VITE_SECURE_BRIDGE_API_BASE_URL=https://api.metayoshi.app

VITE_BRIDGE_AUTOCONFIG_FROM_SERVER_ENV=false
VITE_BRIDGE_AUTOCONFIG_INCLUDE_SECRETS=false
VITE_ENABLE_LOCAL_BACKEND_HELP=false

VITE_DEFAULT_NETWORK=eth
VITE_SWAP_API_VERSION=v1
# Hosted profile: keep every wallet service on the canonical production API origin.
# RTM shop now uses RTM-native bearer session auth discovered from /v1/auth/config.
# Static Basic bridge credentials should stay unset unless a legacy operator flow explicitly requires them.
VITE_BRIDGE_SECURE_WRITES_ENABLED=true

# Leave these blank for the normal hosted profile.
# Fill them only when you intentionally test a legacy Basic-auth gateway.
VITE_BRIDGE_USER=test_user
VITE_BRIDGE_PASSWORD=test_password

VITE_DISABLED_COINS=stellar,ada,xmr,xrp,doge,eth-sepolia, dym, dymension, evmos, gnosis, islm, elys,lume, nls, nolus, oraichain, lumera
