{
  "name": "metayoshi-wallet",
  "private": true,
  "version": "0.0.2-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:browsers": "npm run build && node scripts/package-browser.mjs chromium && node scripts/package-browser.mjs firefox",
    "build:chromium": "npm run build && node scripts/package-browser.mjs chromium",
    "build:firefox": "npm run build && node scripts/package-browser.mjs firefox",
    "zip:chromium": "npm run build:chromium && node scripts/zip-chromium.mjs",
    "zip:firefox": "npm run build:firefox && node scripts/zip-firefox.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-asmjs": "^15.0.3",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "1.3.2",
    "@noble/secp256k1": "^3.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "ethers": "^6.16.0",
    "framer-motion": "^11.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/chrome": "^0.1.36",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.2.2",
    "vite": "^5.1.0"
  }
