{
  "manifest_version": 3,
  "name": "MetaYoshi",
  "description": "Non-custodial Raptoreum (RTM) and BitcoinZ (BTCZ) wallet for coins and assets, powered by ElectrumX.",
  "version": "0.1.0",
  "version_name": "0.1.0-beta",
  "action": {
    "default_icon": {
      "16": "assets/metayoshi-16.png",
      "32": "assets/metayoshi-32.png",
      "48": "assets/metayoshi-48.png",
      "128": "assets/metayoshi-128.png"
    }
  },
  "icons": {
    "16": "assets/metayoshi-16.png",
    "32": "assets/metayoshi-32.png",
    "48": "assets/metayoshi-48.png",
    "128": "assets/metayoshi-128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://metayoshi.app/*",
        "*://*.metayoshi.app/*",
        "*://144.202.18.233/*"
      ],
      "js": [
        "assets/inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/inpage.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "metayoshi@metayoshi.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "sidebar_action": {
    "default_panel": "app/src/ui/index.html?view=sidepanel",
    "default_title": "MetaYoshi",
    "default_icon": {
      "16": "assets/metayoshi-16.png",
      "32": "assets/metayoshi-32.png",
      "48": "assets/metayoshi-48.png",
      "128": "assets/metayoshi-128.png"
    },
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Open MetaYoshi"
    }
  }
}
