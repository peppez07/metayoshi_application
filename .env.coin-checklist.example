# Coin checklist env template (application side)
# Copy entries into .env.local and set true/false per coin.
# ID token rule: lowercase coin id, replace "--" with "__", and "-" with "_".
# Feature keys per coin (optional): NATIVE_SEND, ASSET_LAYER, ASSET_SEND, ACTIVITY, SHOW_ASSETS_TAB, SHOW_ASSETS_ACTION, SHOW_SEND_ACTION, SHOW_ACTIVITY_TAB

